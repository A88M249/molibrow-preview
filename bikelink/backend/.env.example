PORT=4000
SITE_URL=http://localhost:3000
# Extra browser origins allowed to call the API (www, preview, workers.dev), comma-separated
ALLOWED_ORIGINS=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bikelink

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vipps ePayment (portal.vipps.no). Use https://apitest.vipps.no for testing.
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# Back-office API (/admin/*). Leave empty to disable. Use a long random value.
ADMIN_TOKEN=
# Order confirmation emails (optional), e.g. smtps://user:pass@smtp.example.com
SMTP_URL=
MAIL_FROM="BikeLink <info@bikelink.no>"

# Signs dealer (B2B) login tokens. Required for the B2B portal – use a long random value.
JWT_SECRET=
# Where new B2B applications and orders are announced
B2B_NOTIFY_EMAIL=info@bikelink.no

# ── Daily stock file from MMR (CSV by email) ──
# Shared secret between the Cloudflare Email Worker and POST /ingest/stock (leave empty to switch email intake off)
STOCK_INGEST_TOKEN=
# Who may send stock files: addresses or @domains, comma-separated. Required for email intake.
STOCK_ALLOWED_SENDERS=
# false = every file waits for approval in /admin (recommended at first); true = apply files that pass the safety checks
STOCK_AUTO_APPLY=false
# Hold a file for review if total stock would fall by more than this percent
STOCK_MAX_DROP_PCT=60
# keep = SKUs missing from the file keep their stock; zero = set to 0 (only if the file lists everything)
STOCK_MISSING=keep
# Only if the column names are unusual (auto-detected otherwise)
STOCK_SKU_COLUMN=
STOCK_QTY_COLUMN=
STOCK_NOTIFY_EMAIL=info@bikelink.no
# Called after a stock update so the static storefront rebuilds (Cloudflare/Vercel deploy hook URL)
DEPLOY_HOOK_URL=

# ── Alternative to the Cloudflare Email Worker: poll a mailbox over IMAP (npm run stock:poll, run on a schedule) ──
IMAP_HOST=imap.one.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_PROCESSED_MAILBOX=Lager-behandlet
